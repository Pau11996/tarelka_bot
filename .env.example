# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=taarelka_bot
# Канал: username или invite-ссылка
TELEGRAM_CHANNEL=https://t.me/+Y1ttKmidISwyZjMy
# Username чата или invite-ссылка: taarelkachat / https://t.me/+...
TELEGRAM_FEEDBACK_CHAT=taarelkachat
SUPPORT_EMAIL=help.4posts@gmail.com

# Landing page
LANDING_PORT=8080
LANDING_TITLE=ТАРЕЛКА
# Public name of the person or company responsible for the service.
LEGAL_OPERATOR_NAME=Администратор сервиса ТАРЕЛКА

# Admin stats page
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aaadddmmmiiinnn123
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
# Optional estimate from your provider bill for unit economics in the admin dashboard.
AI_ESTIMATED_COST_USD_PER_ANALYSIS=0

# Database
# Local compose: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
POSTGRES_USER=wellhealth
POSTGRES_PASSWORD=wellhealth
POSTGRES_DB=wellhealth
DATABASE_URL=postgresql+asyncpg://wellhealth:wellhealth@postgres:5432/wellhealth
# Production compose uses Supabase — set DATABASE_URL to the Supabase Postgres URI.

# AI Analyzer backend: Cursor CLI (default) or OpenAI API
AI_ANALYZER_URL=http://ai_analyzer:8000
# API=true switches ai_analyzer to OpenAI instead of Cursor CLI
API=false
OPENAI_API_KEY=your-openai-api-key
# Use a mini model by default: it is much cheaper and sufficient for calorie estimates.
OPENAI_MODEL=gpt-4o-mini
# true = one combined model call, false = legacy identify + calculate calls
AI_SINGLE_CALL=true
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=120
# OPENAI_TEMPERATURE=0.2
# For Gemini/OpenRouter thinking: minimal | low | medium | high
# OPENAI_REASONING_EFFORT=medium
# If the server is in an unsupported region, route OpenAI traffic through a proxy:
# OPENAI_HTTP_PROXY=http://proxy.example.com:8080

# Offline voice STT (Vosk). Model is baked into Dockerfile.ai; override path if needed.
# VOSK_MODEL_PATH=/opt/vosk/model

CURSOR_API_KEY=your-cursor-api-key
CURSOR_MODEL=cursor-grok-4.5-high-fast

# Optional: proxy for Cursor CLI inside Docker (corporate networks)
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.pem

# Optional: default timezone for new users
DEFAULT_TIMEZONE=Europe/Moscow

# Optional: auto-delete transient messages after N seconds (default: 7200)
MESSAGE_CLEANUP_TTL_SECONDS=7200

# Optional: daily AI request limit per user (default: 6)
DAILY_REQUEST_LIMIT=6
SUBSCRIPTION_DAILY_REQUEST_LIMIT=30
SUBSCRIPTION_PRICE_STARS=150
SUBSCRIPTION_DURATION_DAYS=30
SUBSCRIPTION_REMINDER_DAYS_BEFORE=2

# Referral reward after an invited user completes the first AI analysis.
REFERRAL_BONUS_REQUESTS=3

# Disabled by default. Enable only after reviewing the message and privacy notice.
REENGAGEMENT_ENABLED=false
REENGAGEMENT_INACTIVITY_DAYS=3
REENGAGEMENT_INTERVAL_SECONDS=21600

# Logs (bot -> /opt/logs/bot, ai_analyzer -> /opt/logs/ai_analyzer)
# LOG_DIR=/opt/logs
