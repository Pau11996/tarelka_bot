# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=taarelka_bot
# Канал: username или invite-ссылка
TELEGRAM_CHANNEL=https://t.me/+Y1ttKmidISwyZjMy
# Username чата или invite-ссылка: taarelkachat / https://t.me/+...
TELEGRAM_FEEDBACK_CHAT=taarelkachat
SUPPORT_EMAIL=help.4posts@gmail.com

# Landing page
LANDING_BOT_USERNAME=taarelka_bot
LANDING_PORT=8080
LANDING_TITLE=ТАРЕЛКА
LANDING_HOST=tarelkaa.by
LANDING_ORIGIN=https://tarelkaa.by
# GA4 web stream for the public site. Not used on /admin.html.
GA_MEASUREMENT_ID=G-DBX8MSSJDK
# Public name of the person or company responsible for the service.
LEGAL_OPERATOR_NAME=Администратор сервиса ТАРЕЛКА

# Admin stats page
ADMIN_USERNAME=admin
ADMIN_PASSWORD=aaadddmmmiiinnn123
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
# Optional estimate from your provider bill for unit economics in the admin dashboard.
AI_ESTIMATED_COST_USD_PER_ANALYSIS=0

# Database
# Local compose: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
POSTGRES_USER=wellhealth
POSTGRES_PASSWORD=wellhealth
POSTGRES_DB=wellhealth
DATABASE_URL=postgresql+asyncpg://wellhealth:wellhealth@postgres:5432/wellhealth
# Production compose uses Supabase — set DATABASE_URL to the Supabase Postgres URI.

# AI Analyzer (OpenAI API)
AI_ANALYZER_URL=http://ai_analyzer:8000
OPENAI_API_KEY=your-openai-api-key
# Use a mini model by default: it is much cheaper and sufficient for calorie estimates.
OPENAI_MODEL=gpt-4o-mini
# Optional per-stage OpenAI models when AI_SINGLE_CALL=false (fallback: OPENAI_MODEL)
# OPENAI_MODEL_CLASSIFY=gpt-4o-mini
# OPENAI_MODEL_PHOTO=gpt-4o-mini
# OPENAI_MODEL_CALC=gpt-4o-mini
# true = one combined model call, false = staged classify → photo detail → calculate
AI_SINGLE_CALL=true
# Read-only product catalog used when a photo is a barcode. Inside Docker this is /opt/data.
# PRODUCT_DB_PATH=data/green_by_products.sqlite
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT=120
# OPENAI_TEMPERATURE=0.2
# For Gemini/OpenRouter thinking: minimal | low | medium | high
# OPENAI_REASONING_EFFORT=medium
# Optional per-stage reasoning when AI_SINGLE_CALL=false (fallback: OPENAI_REASONING_EFFORT)
# OPENAI_REASONING_EFFORT_CLASSIFY=minimal
# OPENAI_REASONING_EFFORT_PHOTO=medium
# OPENAI_REASONING_EFFORT_CALC=medium
# If the server is in an unsupported region, route OpenAI traffic through a proxy:
# OPENAI_HTTP_PROXY=http://proxy.example.com:8080

# Offline voice STT (Vosk). Model is baked into Dockerfile.ai; override path if needed.
# VOSK_MODEL_PATH=/opt/vosk/model

# Optional: proxy for outbound HTTP from the analyzer container
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080

# Optional: default timezone for new users
DEFAULT_TIMEZONE=Europe/Moscow

# Optional: auto-delete transient messages after N seconds (default: 7200)
MESSAGE_CLEANUP_TTL_SECONDS=7200

# Free daily AI limits. Existing users keep the legacy photo quota.
FREE_PHOTO_DAILY_LIMIT=3
LEGACY_FREE_PHOTO_DAILY_LIMIT=6
FREE_TEXT_DAILY_LIMIT=60
FREE_VOICE_DAILY_LIMIT=10
SUBSCRIPTION_DAILY_REQUEST_LIMIT=30
SUBSCRIPTION_TEXT_DAILY_LIMIT=100
SUBSCRIPTION_VOICE_DAILY_LIMIT=30
SUBSCRIPTION_PRICE_STARS=150
SUBSCRIPTION_DURATION_DAYS=30
SUBSCRIPTION_REMINDER_DAYS_BEFORE=2

# Qualified referrals in one calendar month that grant one subscription period.
REFERRAL_MONTHLY_GOAL=5

# Diary empty-day (20:00 local) and 3-day revive reminders. Default: enabled.
# Active users who log every day are not pinged.
DIARY_NUDGES_ENABLED=true
DIARY_NUDGES_INTERVAL_SECONDS=1200

# Mobile API (same database and AI analyzer as the bot).
# JWT secret for the app. Change this before exposing the API.
MOBILE_JWT_SECRET=replace-with-a-long-random-secret
# The production API is exposed by the landing proxy at https://<LANDING_HOST>/api.
# Demo payment remains enabled for the first public APK.
MOBILE_DEMO_BILLING=1
# Local Compose only: published as host:port. Default is localhost only.
# For a phone on the same network set MOBILE_API_PUBLISH=0.0.0.0:8001
# MOBILE_API_PUBLISH=127.0.0.1:8001
# App: EXPO_PUBLIC_API_URL=https://tarelkaa.by/api

# Logs (bot -> /opt/logs/bot, ai_analyzer -> /opt/logs/ai_analyzer)
# LOG_DIR=/opt/logs

# Android Health Connect: enable after migration 019 and native build verification.
HEALTH_CONNECT_ENABLED=0
