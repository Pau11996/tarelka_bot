FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    ffmpeg \
    unzip \
    && rm -rf /var/lib/apt/lists/*

ENV UPLOAD_DIR=/tmp/uploads
ENV VOSK_MODEL_PATH=/opt/vosk/model

# Small Russian offline STT model (~45 MB)
RUN mkdir -p /opt/vosk \
    && curl -fsSL -o /tmp/vosk-model.zip \
        https://alphacephei.com/vosk/models/vosk-model-small-ru-0.22.zip \
    && unzip -q /tmp/vosk-model.zip -d /opt/vosk \
    && mv /opt/vosk/vosk-model-small-ru-0.22 /opt/vosk/model \
    && rm -f /tmp/vosk-model.zip

COPY pyproject.toml ./
COPY src ./src

RUN pip install --no-cache-dir .

RUN mkdir -p /tmp/uploads /opt/logs/ai_analyzer

EXPOSE 8000

CMD ["python", "-m", "src.ai_analyzer.server"]
