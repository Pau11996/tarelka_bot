server {
    listen 80;
    server_name www.${LANDING_HOST};

    return 301 https://${LANDING_HOST}$request_uri;
}

server {
    listen 80 default_server;
    server_name ${LANDING_HOST} _;

    # TLS terminates on the VPS nginx. Relative redirects keep https://tarelkaa.by/index.html
    # on https instead of bouncing to http://.
    absolute_redirect off;

    root /usr/share/nginx/html;
    index index.html;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css text/plain application/javascript application/json application/ld+json application/xml image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https://*.google-analytics.com https://www.googletagmanager.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    # Docker DNS: resolve at request time so nginx can start
    # before ai_analyzer is registered on the network.
    resolver 127.0.0.11 valid=10s ipv6=off;

    error_page 404 /404.html;

    location = /404.html {
        internal;
    }

    # / is served from index.html directly. A public /index.html redirects
    # so the same page is not indexed twice.
    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        return 301 /;
    }

    # Nested index files have one public URL, with a trailing slash.
    if ($request_uri ~ "^(/.+)/index\.html(?:\?.*)?$") {
        return 301 $1/$is_args$args;
    }

    location /admin/ {
        set $analyzer_upstream http://ai_analyzer:8000;
        proxy_pass $analyzer_upstream$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~* \.template\.html$ {
        return 404;
    }

    location = /admin.html {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
        try_files $uri =404;
    }

    location ~* \.(css|js|svg|png|jpg|jpeg|webp|avif|gif|ico|woff2?)$ {
        expires 7d;
        try_files $uri =404;
    }

    location = /health {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
