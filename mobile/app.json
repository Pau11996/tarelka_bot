{
  "expo": {
    "name": "ТАРЕЛКА",
    "slug": "tarelka",
    "scheme": "tarelka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "by.tarelka.app"
    },
    "android": {
      "package": "by.tarelka.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4FBF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "ТАРЕЛКА использует фото, чтобы посчитать калории блюда.",
          "cameraPermission": "ТАРЕЛКА использует камеру, чтобы сфотографировать еду.",
          "microphonePermission": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ТАРЕЛКА использует микрофон, чтобы записать описание еды.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
