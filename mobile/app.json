{
  "expo": {
    "name": "ТАРЕЛКА",
    "slug": "tarelka",
    "scheme": "tarelka",
    "extra": {
      "eas": {
        "projectId": "857cec7e-bc63-4d60-a028-04648c5f9820"
      }
    },
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "by.tarelka.app"
    },
    "android": {
      "versionCode": 2,
      "package": "by.tarelka.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4FBF6",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_WEIGHT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "ТАРЕЛКА использует фото, чтобы посчитать калории блюда.",
          "cameraPermission": "ТАРЕЛКА использует камеру, чтобы сфотографировать еду.",
          "microphonePermission": "ТАРЕЛКА использует микрофон, чтобы записать описание еды."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "ТАРЕЛКА использует микрофон, чтобы записать описание еды.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#23814d"
        }
      ],
      "./plugins/withHealthPrivacy"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
