{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DEMO_BILLING": "1" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tarelkaa.by/api",
        "EXPO_PUBLIC_DEMO_BILLING": "1"
      }
    },
    "production": { "env": { "EXPO_PUBLIC_DEMO_BILLING": "1" } }
  }
}
