{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_DEMO_BILLING": "0" }
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tarelkaa.by/api",
        "EXPO_PUBLIC_DEMO_BILLING": "0"
      }
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://tarelkaa.by/api",
        "EXPO_PUBLIC_SITE_URL": "https://tarelkaa.by",
        "EXPO_PUBLIC_DEMO_BILLING": "0"
      }
    }
  }
}
